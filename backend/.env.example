# IIT Kharagpur identity-provider addresses.
ANANTA_BASE_URL=https://cicidp.iitkgp.ac.in/framework
# External API root. The backend calls /api/v1/users/login/, profile/, and
# logout/. By default the scheme and host are derived from ANANTA_BASE_URL.
ANANTA_API_BASE_URL=https://cicidp.iitkgp.ac.in

# Comma-separated browser origins permitted to call this API.
CIC_ALLOWED_ORIGINS=https://cic.example.edu

# Trust forwarded client addresses only from CIC-controlled reverse proxies.
# Include the exact Docker/proxy subnet here when the proxy is not on loopback.
CIC_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
CIC_HELPDESK_URL=https://cichelpdesk.iitkgp.ac.in/
CIC_SOFTWARE_REPOSITORY_URL=http://swrepo.iitkgp.ac.in/

CIC_MAX_TEAM_PHOTO_SIZE_BYTES=204800
CIC_MAX_TENDER_PDF_SIZE_BYTES=26214400
ANANTA_SESSION_TIMEOUT_SECONDS=5
ANANTA_LOGIN_TIMEOUT_SECONDS=8

# Persistent logging prefers backend/log.txt and automatically falls back to
# backend/content/log.txt if the Gunicorn account cannot write to the backend
# directory. Rotation and locking require no server configuration.
CIC_ACTIVITY_LOG_MAX_BYTES=10485760
CIC_ACTIVITY_LOG_BACKUP_COUNT=5
